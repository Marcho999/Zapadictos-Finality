{
  "name": "zapadictos",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @zapadictos/shared build && pnpm --parallel --filter @zapadictos/shared --filter @zapadictos/api --filter @zapadictos/web dev",
    "dev:api": "pnpm --filter @zapadictos/api dev",
    "dev:web": "pnpm --filter @zapadictos/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @zapadictos/api test:e2e",
    "check": "pnpm --filter @zapadictos/shared build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @zapadictos/api db:migrate",
    "db:seed": "pnpm --filter @zapadictos/api db:seed",
    "db:studio": "pnpm --filter @zapadictos/api db:studio"
  }
}
