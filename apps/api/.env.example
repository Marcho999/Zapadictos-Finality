# Copia este archivo a apps/api/.env. Nunca subas el .env al repositorio.

NODE_ENV=development
PORT=4000

# Debe coincidir con el .env de la raíz (docker-compose.yml).
DATABASE_URL=postgresql://zapadictos:cambia-esta-clave@localhost:5432/zapadictos
# Base para las pruebas e2e (la crea docker/postgres/init.sql).
DATABASE_URL_TEST=postgresql://zapadictos:cambia-esta-clave@localhost:5432/zapadictos_test

# Origen público de la web. Las peticiones que modifican datos deben venir de aquí.
WEB_ORIGIN=http://localhost:3000

# Saltos de proxy confiables para leer la IP real: 1 en local (Nuxt), 2 en producción.
TRUST_PROXY_HOPS=1

# Tarifa fija de envío en COP (D-13).
SHIPPING_COST=15000

# Administrador inicial que crea el seed. La contraseña debe tener al menos 12 caracteres.
SEED_ADMIN_EMAIL=admin@zapadictos.co
SEED_ADMIN_PASSWORD=cambia-esta-clave-larga

# Secreto para firmar los tokens del panel (mínimo 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
ADMIN_JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-48-caracteres

# Cloudinary (opcional en local). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Sin esta variable, las fotos se guardan en apps/api/uploads (solo desarrollo).
# CLOUDINARY_URL=

# Secreto de los tokens de la tienda: distinto del del panel (D-01).
CUSTOMER_JWT_SECRET=cambia-este-otro-secreto-por-uno-aleatorio-distinto

# Wompi sandbox (https://comercios.wompi.co → Desarrolladores). Sin ellas no se puede pagar.
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_INTEGRITY_SECRET=test_integrity_...
# WOMPI_EVENTS_SECRET=test_events_...
WOMPI_API_URL=https://sandbox.wompi.co/v1
